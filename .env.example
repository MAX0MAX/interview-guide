# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# ================================
# LLM Provider 配置
# ================================

# LM Studio 本地 Provider (可选)
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# ---- 预设的 OpenAI 兼容 Provider（默认 enabled=false，填好 Key 后在 Settings UI 开启或改 application.yml）----

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
# PROVIDER_KIMI_API_KEY=your_moonshot_api_key
# PROVIDER_KIMI_MODEL=kimi-latest   # 可选：moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k / kimi-latest

# 智谱 AI / GLM (https://open.bigmodel.cn/)
# PROVIDER_GLM_API_KEY=your_zhipu_api_key
# PROVIDER_GLM_MODEL=glm-4-flash    # 可选：glm-4-plus / glm-4-air / glm-4-flash / glm-4-long

# DeepSeek (https://platform.deepseek.com/)
# PROVIDER_DEEPSEEK_API_KEY=your_deepseek_api_key
# PROVIDER_DEEPSEEK_MODEL=deepseek-chat  # 可选：deepseek-chat / deepseek-reasoner

# 硅基流动 SiliconFlow (https://siliconflow.cn/)
# PROVIDER_SILICONFLOW_API_KEY=your_siliconflow_api_key
# PROVIDER_SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 火山引擎 豆包 Ark / Doubao (https://www.volcengine.com/product/ark)
# 注意：model 填接入点 endpoint-id（形如 ep-xxxxxxxx-xxxxx），不是模型名
# PROVIDER_VOLCENGINE_API_KEY=your_volcengine_api_key
# PROVIDER_VOLCENGINE_MODEL=ep-xxxxxxxx-xxxxx

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与根目录 docker-compose.yml 对齐（本地 bootRun 连 compose 起的依赖时勿改）
# ================================

# PostgreSQL（compose 默认：库 interview_guide / 用户 postgres / 密码 password / 映射端口 5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 兼容存储（compose：MINIO_ROOT_USER/PASSWORD=minioadmin，API 映射 9000）
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide

# AI 模型配置 (默认: qwen3.5-flash)
AI_MODEL=qwen3.5-flash

# 语音面试（可选）：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000

# ================================
# 可选：其他 AI 服务提供商
# ================================

# MiniMax (如果使用 MiniMax 替代 DashScope)
# APP_VOICE_INTERVIEW_LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_GROUP_ID=your_minimax_group_id

# OpenAI (如果使用 OpenAI)
# APP_VOICE_INTERVIEW_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key

# DeepSeek (如果使用 DeepSeek)
# APP_VOICE_INTERVIEW_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
